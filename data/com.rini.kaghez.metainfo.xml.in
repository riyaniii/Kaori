<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.rini.kaghez</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <name>Kaori</name>
  <summary>Discover and read comics on your device</summary>

  <description>
    <p>
      Kaori allows you to discover, download and read comics with a beautiful
      looking UI, and natural touchpad gestures.
    </p>
  </description>

  <developer>
    <name>Riyan Parvez</name>
  </developer>

  <url type="homepage">https://github.com/riyaniii/Kaori</url>
  <url type="vcs-browser">https://github.com/riyaniii/Kaori</url>
  <url type="bugtracker">https://github.com/riyaniii/Kaori/issues</url>
  <url type="contact">https://github.com/riyaniii</url>
  <url type="contribute">https://github.com/riyaniii/Kaori</url>

  <translation type="gettext">kaghez</translation>

  <launchable type="desktop-id">com.rini.kaghez.desktop</launchable>

  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#FFD700</color>
    <color type="primary" scheme_preference="dark">#3F4F82</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://github.com/user-attachments/assets/985faef7-77a9-4ede-b8e9-c1b8421c54b6</image>
      <caption>Home</caption>
    </screenshot>

    <screenshot>
      <image>https://github.com/user-attachments/assets/b937ceb0-4049-4733-a778-b565908b44bf</image>
      <caption>Search</caption>
    </screenshot>

    <screenshot>
      <image>https://github.com/user-attachments/assets/11405fb5-f572-4c72-b442-2be75cbb2c40</image>
      <caption>Reader</caption>
    </screenshot>

    <screenshot>
      <image>https://github.com/user-attachments/assets/09768716-077c-4f63-80d3-a29f62b5d03b</image>
      <caption>Comic Details</caption>
    </screenshot>

    <screenshot>
      <image>https://github.com/user-attachments/assets/7fa8d539-2b09-499e-a7fc-f95684a4904d</image>
      <caption>Downloads</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.8.9" date="2026-10-01">
      <url type="details">
        https://github.com/riyaniii/Kaori/releases/tag/v0.8.9
      </url>
      <description translate="no">
        <p>
          Renamed app to Kaori
          Added proper keyboard navigation for the readers
          Updated Suwayomi-Server
        </p>
      </description>
    </release>
    <release version="0.8.8" date="2026-09-23">
      <url type="details">
        https://github.com/riyaniii/Kaori/releases/tag/v0.8.8
      </url>
      <description translate="no">
        <p>
          Added managed server.
        </p>
      </description>
    </release>
  </releases>
</component>
