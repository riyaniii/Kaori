using Gtk 4.0;
using Adw 1;

template $KaoriWindow : Adw.ApplicationWindow {
  default-width: 1100;
  default-height: 700;
  width-request: 360;
  height-request: 294;

  content: Gtk.Stack window_stack {
    transition-type: crossfade;

    Gtk.StackPage {
      name: "start";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;
        }

        content: Adw.StatusPage {
          icon-name: "io.github.riyaniii.Kaori";
          title: _("Kaori");
        };
      };
    }

    Gtk.StackPage {
      name: "main";
      child: Adw.Bin main_bin {};
    }
  };
}
