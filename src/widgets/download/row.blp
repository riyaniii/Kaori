using Gtk 4.0;

template $KaoriDownloadRow : Gtk.Box {
  orientation: horizontal;
  spacing: 12;
  margin-start: 8;
  margin-end: 8;
  margin-top: 12;
  margin-bottom: 12;

  Gtk.Image handle {
    styles [
      "dim-label"
    ]
    icon-name: "list-drag-handle-symbolic";
    tooltip-text: _("Drag to reorder");
  }

  Gtk.Box {
    orientation: vertical;
    spacing: 3;
    hexpand: true;
    valign: center;

    Gtk.Label {
      label: bind template.model as <$KaoriDownload> .manga_title;
      xalign: 0.0;
      ellipsize: end;
    }

    Gtk.Label {
      styles [
        "dim-label"
      ]
      label: bind template.model as <$KaoriDownload> .chapter_name;
      xalign: 0.0;
      ellipsize: end;
    }

    Gtk.ProgressBar {
      fraction: bind template.model as <$KaoriDownload> .progress;
    }
  }

  Gtk.Button retry {
    styles [
      "flat",
      "circular"
    ]
    valign: center;
    icon-name: "view-refresh-symbolic";
    tooltip-text: _("Retry");
    visible: bind $is_error(template.model as <$KaoriDownload> .state) as <bool>;
    clicked => $on_retry_clicked();
  }

  Gtk.Button remove {
    styles [
      "flat",
      "circular"
    ]
    valign: center;
    icon-name: "list-remove-symbolic";
    tooltip-text: _("Remove from queue");
    clicked => $on_remove_clicked();
  }
}