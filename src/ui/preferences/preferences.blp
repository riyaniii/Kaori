using Gtk 4.0;
using Adw 1;

template $KaoriPreferencesDialog : Adw.PreferencesDialog {
  Adw.PreferencesPage {
    title: _("Reader");
    icon-name: "view-paged-symbolic";

    Adw.PreferencesGroup {
      title: _("Reading");
      description: _("This sets the global reader settings");

      Adw.InlineViewSwitcher {
        margin-top: 12;
        stack: bind template.mode_stack;
        margin-bottom: 12;
        sensitive: bind template.loaded;
      }

      Adw.ComboRow orientation_row {
        title: _("Webtoon Orientation");
        model: Gtk.StringList {
          strings [_("Vertical"), _("Horizontal")]
        };
        notify::selected => $on_orientation_changed();
      }

      Adw.ComboRow direction_row {
        title: _("Reading Direction");
        model: Gtk.StringList {
          strings [_("Left to Right"), _("Right to Left")]
        };
        sensitive: bind template.loaded;
        notify::selected => $on_direction_changed();
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Library");
    icon-name: "library-symbolic";

    Adw.PreferencesGroup {
      title: _("Updates");
      sensitive: bind template.loaded;

      Adw.SpinRow update_interval_row {
        title: _("Update Interval");
        subtitle: _("Hours between library updates, at least 6, or 0 to turn it off");
        adjustment: Gtk.Adjustment {
          lower: 0;
          upper: 720;
          step-increment: 1;
          page-increment: 6;
        };
        notify::value => $on_spin_changed();
      }

      Adw.SpinRow parallel_sources_row {
        title: _("Parallel Sources");
        subtitle: _("How many sources can update or download at the same time");
        adjustment: Gtk.Adjustment {
          lower: 1;
          upper: 20;
          step-increment: 1;
          page-increment: 2;
        };
        notify::value => $on_spin_changed();
      }
    }

    Adw.PreferencesGroup {
      title: _("Extensions");
      sensitive: bind template.loaded;

      Adw.ActionRow {
        title: _("Extension Stores");
        subtitle: _("Where extensions can be installed from");
        activatable: true;
        activated => $on_stores_activated();

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Local Source");
      description: _("Read manga stored on your computer. Put each manga in its own folder, with a folder or a CBZ for every chapter, and add a cover.jpg for a custom cover");
      sensitive: bind template.loaded;

      Adw.ActionRow local_source_row {
        title: _("Local Source Folder");
        subtitle: _("Default");
        activatable: true;
        activated => $on_path_activated();

        [suffix]
        Gtk.Button {
          styles ["flat"]
          valign: center;
          icon-name: "edit-clear-symbolic";
          tooltip-text: _("Use Default");
          clicked => $on_path_cleared();
        }

        [suffix]
        Gtk.Button {
          styles ["flat"]
          valign: center;
          icon-name: "folder-open-symbolic";
          tooltip-text: _("Open Folder");
          visible: bind template.local;
          clicked => $on_path_opened();
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Storage");
    icon-name: "folder-symbolic";

    Adw.PreferencesGroup {
      title: _("Downloads");
      sensitive: bind template.loaded;

      Adw.SwitchRow cbz_row {
        title: _("Save as CBZ Archive");
        subtitle: _("Compress each downloaded chapter into a single CBZ file");
        notify::active => $on_switch_toggled();
      }

      Adw.ActionRow location_row {
        title: _("Download Location");
        subtitle: _("Default");
        activatable: true;
        activated => $on_path_activated();

        [suffix]
        Gtk.Button {
          styles ["flat"]
          valign: center;
          icon-name: "edit-clear-symbolic";
          tooltip-text: _("Use Default");
          clicked => $on_path_cleared();
        }

        [suffix]
        Gtk.Button {
          styles ["flat"]
          valign: center;
          icon-name: "folder-open-symbolic";
          tooltip-text: _("Open Folder");
          visible: bind template.local;
          clicked => $on_path_opened();
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Backups");
      description: _("The server saves a copy of your library on a schedule");
      sensitive: bind template.loaded;

      Adw.ActionRow backup_path_row {
        title: _("Backup Location");
        subtitle: _("Default");
        activatable: true;
        activated => $on_path_activated();

        [suffix]
        Gtk.Button {
          styles ["flat"]
          valign: center;
          icon-name: "edit-clear-symbolic";
          tooltip-text: _("Use Default");
          clicked => $on_path_cleared();
        }

        [suffix]
        Gtk.Button {
          styles ["flat"]
          valign: center;
          icon-name: "folder-open-symbolic";
          tooltip-text: _("Open Folder");
          visible: bind template.local;
          clicked => $on_path_opened();
        }
      }

      Adw.EntryRow backup_time_row {
        title: _("Backup Time (HH:MM)");
        show-apply-button: true;
        apply => $on_entry_applied();
      }

      Adw.SpinRow backup_interval_row {
        title: _("Backup Interval");
        subtitle: _("Days between backups, or 0 to turn them off");
        adjustment: Gtk.Adjustment {
          lower: 0;
          upper: 365;
          step-increment: 1;
          page-increment: 7;
        };
        notify::value => $on_spin_changed();
      }

      Adw.SpinRow backup_retention_row {
        title: _("Keep Backups For");
        subtitle: _("Days before old backups are deleted, or 0 to keep them");
        adjustment: Gtk.Adjustment {
          lower: 0;
          upper: 365;
          step-increment: 1;
          page-increment: 7;
        };
        notify::value => $on_spin_changed();
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Server");
    icon-name: "network-server-symbolic";

    Adw.PreferencesGroup background_group {
      title: _("Background");

      Adw.SwitchRow background_row {
        title: _("Keep Server Running in Background");
        subtitle: _("Keep the local server running after the window is closed");
      }

      Adw.SwitchRow startup_row {
        title: _("Run on Startup");
        subtitle: _("Start the server automatically when you log in");
        sensitive: bind background_row.active;
      }
    }

    Adw.PreferencesGroup {
      title: _("Cloudflare Bypass");
      description: _("Use FlareSolverr or Byparr to get past Cloudflare checks on sources");
      sensitive: bind template.loaded;

      Adw.SwitchRow flaresolverr_row {
        title: _("Use FlareSolverr");
        notify::active => $on_switch_toggled();
      }

      Adw.EntryRow flaresolverr_url_row {
        title: _("Server URL");
        input-purpose: url;
        show-apply-button: true;
        sensitive: bind flaresolverr_row.active;
        apply => $on_entry_applied();
      }

      Adw.SpinRow flaresolverr_timeout_row {
        title: _("Timeout");
        subtitle: _("Seconds to wait for a challenge to be solved");
        sensitive: bind flaresolverr_row.active;
        adjustment: Gtk.Adjustment {
          lower: 1;
          upper: 600;
          step-increment: 5;
          page-increment: 30;
        };
        notify::value => $on_spin_changed();
      }

      Adw.EntryRow flaresolverr_session_row {
        title: _("Session Name");
        show-apply-button: true;
        sensitive: bind flaresolverr_row.active;
        apply => $on_entry_applied();
      }

      Adw.SpinRow flaresolverr_ttl_row {
        title: _("Session Lifetime");
        subtitle: _("Minutes before FlareSolverr forgets its cookies");
        sensitive: bind flaresolverr_row.active;
        adjustment: Gtk.Adjustment {
          lower: 1;
          upper: 1440;
          step-increment: 5;
          page-increment: 30;
        };
        notify::value => $on_spin_changed();
      }

      Adw.SwitchRow flaresolverr_fallback_row {
        title: _("Use Response as Fallback");
        subtitle: _("Use the page FlareSolverr got when only Suwayomi sees a challenge");
        sensitive: bind flaresolverr_row.active;
        notify::active => $on_switch_toggled();
      }
    }

    Adw.PreferencesGroup {
      title: _("Proxy");
      description: _("Send the server's network traffic through a SOCKS proxy");
      sensitive: bind template.loaded;

      Adw.SwitchRow proxy_row {
        title: _("Use SOCKS Proxy");
        notify::active => $on_switch_toggled();
      }

      Adw.ComboRow proxy_version_row {
        title: _("Version");
        model: Gtk.StringList {
          strings ["SOCKS5", "SOCKS4"]
        };
        sensitive: bind proxy_row.active;
        notify::selected => $on_proxy_version_changed();
      }

      Adw.EntryRow proxy_host_row {
        title: _("Host");
        show-apply-button: true;
        sensitive: bind proxy_row.active;
        apply => $on_entry_applied();
      }

      Adw.EntryRow proxy_port_row {
        title: _("Port");
        show-apply-button: true;
        sensitive: bind proxy_row.active;
        apply => $on_entry_applied();
      }

      Adw.EntryRow proxy_username_row {
        title: _("Username");
        show-apply-button: true;
        sensitive: bind proxy_row.active;
        apply => $on_entry_applied();
      }

      Adw.PasswordEntryRow proxy_password_row {
        title: _("Password");
        show-apply-button: true;
        sensitive: bind proxy_row.active;
        apply => $on_entry_applied();
      }
    }

    Adw.PreferencesGroup {
      title: _("Instance");

      Adw.ActionRow {
        title: _("Suwayomi Instance");
        subtitle: _("Switch between a local or remote server");
        activatable: true;
        action-name: "app.change_instance";

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }

      Adw.ActionRow {
        title: _("Open in Browser");
        subtitle: _("Open the server's web interface");
        activatable: true;
        activated => $on_open_browser_activated();

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }
    }
  }
}